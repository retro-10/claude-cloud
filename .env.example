# Copy to .env and edit. Never commit .env.

# Postgres (used by docker compose and by the app)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=crm

# App -> database. Inside compose the host is "db"; for local dev outside compose use localhost.
# Keep the password here identical to POSTGRES_PASSWORD.
DATABASE_URL=postgres://crm:change-me-db@db:5432/crm

# Session signing key, at least 32 random characters. Generate: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Set to true only when serving over HTTPS (adds the Secure flag to the session cookie, sends HSTS).
# docker-compose.prod.yml forces this to true.
COOKIE_SECURE=false

# Initial password given to the four seeded accounts on their first start. Everyone is nagged to
# change it after signing in (My account). Use a long random value, and CHANGE it before going live.
SEED_PASSWORD=change-me-demo

# Add 20 demo leads (with consults, enrolments, follow-ups) on first start, only into an empty database.
# Set to false for the real deployment.
SEED_DEMO=true

# Port exposed on the host (development compose file only)
APP_PORT=3000

# --- Production (docker-compose.prod.yml) ---
# Your domain, already pointing at this server. Caddy gets the HTTPS certificate for it automatically.
# DOMAIN=crm.example.com

# --- Optional ---
# Failed sign-in attempts allowed per 15 minutes (defaults shown). Only failures count.
# LOGIN_MAX_FAILED_PER_ACCOUNT=5
# LOGIN_MAX_FAILED_PER_IP=20
# Backups (scripts/backup.sh): where to put them and how many to keep
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
