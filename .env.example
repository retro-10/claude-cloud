# Copy to .env and edit. Never commit .env.

# Postgres (used by docker compose and by the app)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=crm

# App -> database. Inside compose the host is "db"; for local dev outside compose use localhost.
# Keep the password here identical to POSTGRES_PASSWORD.
DATABASE_URL=postgres://crm:change-me-db@db:5432/crm

# Session signing key, at least 32 random characters. Generate: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Set to true only when serving over HTTPS (adds the Secure flag to the session cookie, sends HSTS).
# docker-compose.prod.yml forces this to true.
COOKIE_SECURE=false

# Initial password given to the four seeded accounts on their first start. Everyone is nagged to
# change it after signing in (My account). Use a long random value, and CHANGE it before going live.
SEED_PASSWORD=change-me-demo

# Add 20 demo leads (with consults, enrolments, follow-ups) on first start, only into an empty database.
# Set to false for the real deployment.
SEED_DEMO=false

# Inbound lead webhook (optional): POST /api/inbound/leads with "Authorization: Bearer <token>", for Meta lead
# ads through Zapier or Make, or a partner site. Off until set; use 24+ random characters (openssl rand -hex 24).
INBOUND_LEADS_TOKEN=

# Port exposed on the host (development compose file only)
APP_PORT=3000

# --- Production (docker-compose.prod.yml) ---
# Your domain, already pointing at this server. Caddy gets the HTTPS certificate for it automatically.
# DOMAIN=crm.example.com

# --- Hosted database (Supabase) and hosts without Docker (Hostinger Node.js apps) ---
# Put Supabase's "Session pooler" connection string in DATABASE_URL (Project > Connect; port 5432, works over
# IPv4). TLS is switched on by itself for Supabase hosts. The transaction pooler (port 6543) also works.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Connections the app may hold (default 10). Keep it under your plan's pool size.
# DATABASE_POOL_MAX=10
# Apply migrations and reference data when the app starts. Needed where nothing runs docker-entrypoint.sh.
# MIGRATE_ON_START=true

# --- Google Drive (optional): keep uploaded files in Drive instead of the database ---
# Option 1, any Google account (a Gmail works): create an OAuth client (type "Web application") in Google Cloud,
# add https://<your domain>/settings/integrations/drive/callback as an authorised redirect URI, set these two,
# then an owner clicks Connect Google Drive in Settings > Integrations. Never commit the real secret.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Option 2, Google Workspace: a service account's JSON key (the JSON itself or base64 of it) plus a folder in a
# shared drive the service account is a member of (Content manager).
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_FOLDER_ID=

# --- Email (optional): notification digests to staff, through Resend (https://resend.com) ---
# Verify the orladent.com domain in Resend (3 DNS records), create an API key, then set both. Without the key no
# email is sent and people use the bell and the Inbox.
# RESEND_API_KEY=
# EMAIL_FROM=OrlaDent HQ <hq@orladent.com>

# --- Optional ---
# Failed sign-in attempts allowed per 15 minutes (defaults shown). Only failures count.
# LOGIN_MAX_FAILED_PER_ACCOUNT=5
# LOGIN_MAX_FAILED_PER_IP=20
# Backups (scripts/backup.sh): where to put them and how many to keep
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# --- AI assistant (optional): Ask OrlaDent, drafts and consult briefs ---
# An API key from https://console.anthropic.com. Without it the assistant stays off; with it, an owner still has
# to switch it on in Settings > AI assistant. Never commit the real key.
# ANTHROPIC_API_KEY=
# The Claude model to use (default claude-opus-5-5)
# AI_MODEL=

# --- Notion (optional): two-way sync with the OrlaDent Camp workspace ---
# Create an internal integration at https://www.notion.so/my-integrations, then in Notion open the
# "OrlaDent Camp" page > ... > Connections > add the integration (it then sees the pages under it).
# Leave NOTION_TOKEN empty to switch the sync off. Never commit the real token.
# NOTION_TOKEN=
# The databases default to the camp's Batches, Candidates, Ledger, Sessions, Proof & Testimonial Bank and Team;
# override only if they move.
# NOTION_BATCHES_DB=c3e0b4ef-e18f-48c6-9eec-aeb3e1f4d951
# NOTION_CANDIDATES_DB=ed8f45c4-e790-42e4-a0fe-841d14cbbc42
# NOTION_LEDGER_DB=117399e6-dbad-4d65-ac2c-96f018aebc7e
# NOTION_SESSIONS_DB=1ade3ea7-6c29-4022-9dd7-5d26187b00bf
# NOTION_PROOF_DB=a4df71c2-181d-46f9-9bbb-83300ed75379
# NOTION_TEAM_DB=7e7b2eb3-c2f3-44e1-9104-c4cb814c0f70
# Page under which the sync creates the "CRM Leads" database on its first run (or give an existing one)
# NOTION_PARENT_PAGE=3e45624a-2246-81e5-9dfc-dd61a4550e7c
# NOTION_LEADS_DB=
# Leads are mirrored to a "CRM Leads" database in Notion (decided by the owners). false keeps them out.
NOTION_SYNC_LEADS=true
# Seconds between syncs (minimum 30)
# NOTION_SYNC_INTERVAL_SEC=60
# Address of the CRM, for the "Open in CRM" link on each Notion lead (defaults to https://DOMAIN)
# APP_URL=

# Vercel only (see the README): the scheduler's token for /api/cron/tick, the build's migration URL (session
# pooler), no in-app backup (a GitHub Action takes it), and the upload limit Vercel allows.
# CRON_SECRET=
# MIGRATE_DATABASE_URL=
# BACKUP_IN_APP=false
# NEXT_PUBLIC_MAX_UPLOAD_MB=4

